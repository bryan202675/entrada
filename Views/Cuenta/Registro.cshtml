@model RegistroInput
@{
    ViewData["Title"] = "Crear cuenta";
}
<section class="auth-page container">
    <div class="auth-shell">
        <form method="post" class="form-card">
            <div class="form-heading"><span class="eyebrow">Tu pase personal</span><h1>Crea tu cuenta</h1><p>Reserva eventos y conserva todos tus códigos en un lugar.</p></div>
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <label class="field"><span>Nombre completo</span><input asp-for="Nombre" autocomplete="name" placeholder="Tu nombre" /><span asp-validation-for="Nombre"></span></label>
            <label class="field"><span>Correo electrónico</span><input asp-for="Email" autocomplete="email" placeholder="nombre@correo.com" /><span asp-validation-for="Email"></span></label>
            <label class="field"><span>Contraseña</span><input asp-for="Password" autocomplete="new-password" placeholder="Mínimo 8 caracteres" /><span asp-validation-for="Password"></span></label>
            <button class="button button-block" type="submit" data-loading-button><span>Crear cuenta</span></button>
            <p class="form-alternative">¿Ya tienes cuenta? <a asp-action="Login">Iniciar sesión</a></p>
        </form>
        <p class="auth-note">Al continuar podrás reservar entradas para cualquier evento publicado.</p>
    </div>
</section>

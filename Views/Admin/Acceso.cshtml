@model AccesoViewModel
@{
    ViewData["Title"] = "Control de acceso";
}
<section class="access-page container">
    <div class="access-heading"><div><a class="breadcrumb-link" asp-action="Index">← Panel operativo</a><span class="eyebrow">Control de acceso</span><h1>Validar entrada</h1><p>Comprueba un código y registra el ingreso en una sola operación.</p></div><span class="live-status"><i></i>Puesto activo</span></div>
    <div class="access-layout">
        <form method="post" class="access-form panel-surface">
            <div class="panel-heading"><span>Nueva validación</span><h2>Datos del boleto</h2><p>Elige la función antes de comprobar el código.</p></div>
            <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
            <label class="field"><span>Evento</span><select asp-for="Formulario.EventoId" name="EventoId"><option value="">Selecciona un evento</option>@foreach (var evento in Model.Eventos){<option value="@evento.Id">@evento.Titulo</option>}</select></label>
            <label class="field code-field"><span>Código único</span><input asp-for="Formulario.Codigo" name="Codigo" autocomplete="off" autocapitalize="characters" placeholder="ENT-000001" /></label>
            <button class="button button-block" type="submit" data-loading-button><span>Validar ingreso</span></button>
            <p class="secure-note">Cada código solo puede utilizarse una vez.</p>
        </form>
        <div class="access-feedback panel-surface">
            @if (Model.Resultado is null)
            {
                <div class="access-idle"><span class="scan-icon" aria-hidden="true"><i></i><i></i><i></i><i></i></span><h2>Esperando un código</h2><p>El resultado aparecerá aquí inmediatamente después de validar.</p></div>
            }
            else
            {
                <div class="access-result @(Model.Resultado.Permitido ? "is-approved" : "is-rejected")" role="status">
                    <span class="result-mark">@(Model.Resultado.Permitido ? "✓" : "×")</span><span class="result-label">@(Model.Resultado.Permitido ? "Ingreso autorizado" : "Ingreso rechazado")</span><h2>@Model.Resultado.Mensaje</h2>
                    @if (Model.Resultado.Encontrado)
                    {
                        <dl><div><dt>Evento</dt><dd>@Model.Resultado.Evento</dd></div><div><dt>Asistente</dt><dd>@Model.Resultado.Asistente</dd></div><div><dt>Tipo</dt><dd>@Model.Resultado.Tipo</dd></div>@if (Model.Resultado.FechaUso.HasValue){<div><dt>Registro</dt><dd>@DateTime.SpecifyKind(Model.Resultado.FechaUso.Value, DateTimeKind.Utc).ToLocalTime().ToString("dd MMM · h:mm:ss tt")</dd></div>}</dl>
                    }
                    <a class="button button-secondary" asp-action="Acceso">Validar otro boleto</a>
                </div>
            }
        </div>
    </div>
</section>

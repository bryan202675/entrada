@model CatalogoViewModel
@{
    ViewData["Title"] = "Programación";
    var culturaSv = new System.Globalization.CultureInfo("es-SV");

    var eventosData = Model.Eventos.Select(e =>
    {
        var fechaLocal = DateTime.SpecifyKind(e.Fecha, DateTimeKind.Utc).ToLocalTime();
        return new
        {
            id = e.Id,
            titulo = e.Titulo,
            descripcion = e.Descripcion,
            fechaIso = e.Fecha.ToString("o"),
            fechaLocalIso = fechaLocal.ToString("yyyy-MM-ddTHH:mm:ss"),
            dia = fechaLocal.Day,
            mes = fechaLocal.Month,
            anio = fechaLocal.Year,
            fechaTexto = fechaLocal.ToString("dddd, d 'de' MMMM · h:mm tt", culturaSv),
            fechaCorta = fechaLocal.ToString("dd MMM", culturaSv).ToUpperInvariant(),
            horaTexto = fechaLocal.ToString("h:mm tt", culturaSv),
            ubicacion = e.Ubicacion,
            imagen = string.IsNullOrWhiteSpace(e.Imagen) ? "/images/evento-fallback.jpg" : e.Imagen,
            stockDisponible = e.StockDisponible,
            capacidadTotal = e.CapacidadTotal,
            precioDesde = e.PrecioDesde.ToString("C", culturaSv),
            reservaUrl = Url.Action("Reserva", "Eventos", new { id = e.Id }),
            tipos = e.Tipos.Select(t => new
            {
                id = t.Id,
                nombre = t.Nombre,
                precio = t.Precio.ToString("C", culturaSv),
                stock = t.StockDisponible,
                capacidad = t.CapacidadTotal
            })
        };
    });
    var jsonEventos = System.Text.Json.JsonSerializer.Serialize(eventosData);
}
<section class="catalog-page container">
    <header class="catalog-heading">
        <div>
            <h1>Calendario y Cartelera de Eventos</h1>
            <p>Explora las fechas programadas, consulta aforos en tiempo real y reserva tus entradas.</p>
        </div>
        <span class="catalog-edition">ENTRADA <b>·</b> TEMPORADA CULTURAL</span>
    </header>

    @if (Model.Error is not null)
    {
        <div class="state-panel state-error" role="alert">
            <span class="state-icon" aria-hidden="true">!</span>
            <div><h2>No se pudo cargar la programación</h2><p>@Model.Error</p></div>
            <a class="button button-secondary" asp-action="Index">Reintentar</a>
        </div>
    }
    else if (Model.Eventos.Count == 0)
    {
        <div class="state-panel">
            <span class="state-icon" aria-hidden="true">○</span>
            <div><h2>Aún no hay eventos publicados</h2><p>Vuelve pronto para descubrir nuevas experiencias.</p></div>
            <a class="button button-secondary" asp-controller="Inicio" asp-action="Index">Volver al inicio</a>
        </div>
    }
    else
    {
        <!-- Barra de herramientas: Selector de vista (Calendario / Cartelera) y Búsqueda rápida -->
        <div class="catalog-tools" id="programacion">
            <div class="catalog-view-switch" role="tablist" aria-label="Cambiar vista">
                <button type="button" class="view-switch-btn is-active" id="btn-view-calendar" role="tab" aria-selected="true" aria-controls="calendar-section">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="3"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    <span>Vista Calendario</span>
                </button>
                <button type="button" class="view-switch-btn" id="btn-view-grid" role="tab" aria-selected="false" aria-controls="grid-section">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
                    <span>Vista Cartelera</span>
                </button>
            </div>

            <div class="catalog-tools-right">
                <label class="catalog-search" for="buscar">
                    <span aria-hidden="true">⌕</span>
                    <input id="buscar" type="search" placeholder="Buscar por evento, disciplina o lugar" autocomplete="off" data-event-search />
                </label>
                <p><strong data-search-count>@Model.Eventos.Count</strong> experiencias disponibles</p>
            </div>
        </div>

        <!-- 1. VISTA CALENDARIO DINÁMICO -->
        <div id="calendar-section" class="calendar-view-wrap" role="tabpanel" aria-labelledby="btn-view-calendar">
            <div class="calendar-shell">
                <div class="calendar-nav-bar">
                    <div class="cal-title-group">
                        <h2 class="cal-month-title" id="cal-month-display">Noviembre 2026</h2>
                        <span class="cal-badge-count" id="cal-month-count">Cargando eventos...</span>
                    </div>
                    <div class="cal-nav-actions">
                        <button type="button" class="cal-nav-btn" id="cal-prev" aria-label="Mes anterior">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m15 18-6-6 6-6"/></svg>
                        </button>
                        <button type="button" class="cal-today-btn" id="cal-today">Hoy</button>
                        <button type="button" class="cal-nav-btn" id="cal-next" aria-label="Mes siguiente">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m9 18 6-6-6-6"/></svg>
                        </button>
                    </div>
                </div>

                <div class="calendar-weekdays" aria-hidden="true">
                    <span>LUN</span>
                    <span>MAR</span>
                    <span>MIÉ</span>
                    <span>JUE</span>
                    <span>VIE</span>
                    <span>SÁB</span>
                    <span>DOM</span>
                </div>

                <div class="calendar-days-grid" id="calendar-days-grid" role="grid">
                    <!-- Generado dinámicamente con JavaScript -->
                </div>
            </div>

            <!-- Resumen de fechas del mes -->
            <div class="cal-upcoming-card">
                <div class="cal-upcoming-head">
                    <div>
                        <h3 id="upcoming-headline">Eventos del mes seleccionado</h3>
                    </div>
                    <span class="cal-help-hint">Haz clic en cualquier boleto para ver información y reservar</span>
                </div>
                <div class="cal-upcoming-list" id="cal-upcoming-list">
                    <!-- Se llena con JS según el mes visible -->
                </div>
            </div>
        </div>

        <!-- 2. VISTA CARTELERA (Cuadrícula de tickets) -->
        <div id="grid-section" class="grid-view-wrap" role="tabpanel" aria-labelledby="btn-view-grid" hidden>
            <div class="catalog-grid" data-event-list>
                @foreach (var evento in Model.Eventos)
                {
                    var fecha = DateTime.SpecifyKind(evento.Fecha, DateTimeKind.Utc).ToLocalTime();
                    <article class="catalog-card" data-event-card data-search="@($"{evento.Titulo} {evento.Descripcion} {evento.Ubicacion}")" data-event-id="@evento.Id">
                        <div class="catalog-ticket-cover">
                            <a class="catalog-image" href="javascript:void(0)" data-open-modal="@evento.Id" aria-label="Ver detalles de @evento.Titulo">
                                <img src="@(string.IsNullOrWhiteSpace(evento.Imagen) ? "/images/evento-fallback.jpg" : evento.Imagen)" data-image-fallback="/images/evento-fallback.jpg" alt="" width="640" height="420" loading="lazy" />
                                <span>@fecha.ToString("dd MMM", culturaSv).ToUpperInvariant()</span>
                            </a>
                            <div class="ticket-cut-divider" aria-hidden="true">
                                <span class="cut-notch notch-left"></span>
                                <span class="cut-line"></span>
                                <span class="cut-notch notch-right"></span>
                            </div>
                        </div>
                        <div class="catalog-card-body">
                            <div class="catalog-card-kicker-row">
                                <span class="catalog-card-edition">PASE OFICIAL</span>
                                <span class="catalog-card-price">Desde @evento.PrecioDesde.ToString("C", culturaSv)</span>
                            </div>
                            <h2 class="catalog-card-title">@evento.Titulo</h2>
                            <p class="catalog-card-desc">@evento.Descripcion</p>
                            <div class="catalog-card-meta">
                                <span>
                                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                    @fecha.ToString("dddd · h:mm tt", culturaSv)
                                </span>
                                <span>
                                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"/><circle cx="12" cy="10" r="3"/></svg>
                                    @evento.Ubicacion
                                </span>
                            </div>

                            <div class="catalog-barcode-wrap" title="Código digital de acceso">
                                <svg class="pass-barcode" viewBox="0 0 160 32" preserveAspectRatio="none" aria-hidden="true">
                                    <rect x="0" y="0" width="2.5" height="32" fill="#0f0f0e"/>
                                    <rect x="4.5" y="0" width="1.2" height="32" fill="#0f0f0e"/>
                                    <rect x="7.5" y="0" width="3.2" height="32" fill="#0f0f0e"/>
                                    <rect x="13" y="0" width="1.5" height="32" fill="#0f0f0e"/>
                                    <rect x="16" y="0" width="4" height="32" fill="#0f0f0e"/>
                                    <rect x="22" y="0" width="2" height="32" fill="#0f0f0e"/>
                                    <rect x="26" y="0" width="1.2" height="32" fill="#0f0f0e"/>
                                    <rect x="29" y="0" width="3" height="32" fill="#0f0f0e"/>
                                    <rect x="34" y="0" width="2" height="32" fill="#0f0f0e"/>
                                    <rect x="38" y="0" width="4.2" height="32" fill="#0f0f0e"/>
                                    <rect x="44.5" y="0" width="1.2" height="32" fill="#0f0f0e"/>
                                    <rect x="48" y="0" width="2.5" height="32" fill="#0f0f0e"/>
                                    <rect x="52.5" y="0" width="3" height="32" fill="#0f0f0e"/>
                                    <rect x="57.5" y="0" width="1.2" height="32" fill="#0f0f0e"/>
                                    <rect x="61" y="0" width="2.2" height="32" fill="#0f0f0e"/>
                                    <rect x="65" y="0" width="4" height="32" fill="#0f0f0e"/>
                                    <rect x="71" y="0" width="1.5" height="32" fill="#0f0f0e"/>
                                    <rect x="74.5" y="0" width="1.2" height="32" fill="#0f0f0e"/>
                                    <rect x="78" y="0" width="3.2" height="32" fill="#0f0f0e"/>
                                    <rect x="83.5" y="0" width="1.2" height="32" fill="#0f0f0e"/>
                                    <rect x="87" y="0" width="2.5" height="32" fill="#0f0f0e"/>
                                    <rect x="91.5" y="0" width="3.5" height="32" fill="#0f0f0e"/>
                                    <rect x="97" y="0" width="1.5" height="32" fill="#0f0f0e"/>
                                    <rect x="100.5" y="0" width="2.2" height="32" fill="#0f0f0e"/>
                                    <rect x="105" y="0" width="4" height="32" fill="#0f0f0e"/>
                                    <rect x="111" y="0" width="1.2" height="32" fill="#0f0f0e"/>
                                    <rect x="114" y="0" width="3" height="32" fill="#0f0f0e"/>
                                    <rect x="119" y="0" width="2" height="32" fill="#0f0f0e"/>
                                    <rect x="123" y="0" width="3.8" height="32" fill="#0f0f0e"/>
                                    <rect x="128.5" y="0" width="1.5" height="32" fill="#0f0f0e"/>
                                    <rect x="132" y="0" width="3" height="32" fill="#0f0f0e"/>
                                    <rect x="137" y="0" width="2.2" height="32" fill="#0f0f0e"/>
                                    <rect x="141" y="0" width="4" height="32" fill="#0f0f0e"/>
                                    <rect x="147" y="0" width="1.2" height="32" fill="#0f0f0e"/>
                                    <rect x="150" y="0" width="2.8" height="32" fill="#0f0f0e"/>
                                    <rect x="155" y="0" width="4.5" height="32" fill="#0f0f0e"/>
                                </svg>
                                <span class="pass-barcode-text">* EVT-00@evento.Id-BOLETO *</span>
                            </div>

                            <div class="catalog-card-actions">
                                <button type="button" class="catalog-preview-btn" data-open-modal="@evento.Id">Ver detalles</button>
                                @if (User.IsInRole("Administrador"))
                                {
                                    <div class="admin-card-actions">
                                        <a class="button button-small button-secondary" asp-controller="Admin" asp-action="Index" asp-route-editar="@evento.Id" asp-fragment="editor">Editar</a>
                                        <form asp-controller="Admin" asp-action="CancelarEvento" asp-route-id="@evento.Id" method="post" style="display:inline;" onsubmit="return confirm('¿Seguro que deseas cancelar/eliminar este evento?');">
                                            <button type="submit" class="button button-small button-danger">Eliminar</button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <a class="catalog-card-cta" asp-action="Reserva" asp-route-id="@evento.Id">
                                        <span>Reservar</span>
                                        <span class="cta-arrow" aria-hidden="true">↗</span>
                                    </a>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
            <div class="state-panel catalog-no-results" data-search-empty hidden role="status">
                <span class="state-icon" aria-hidden="true">⌕</span>
                <div><h2>Sin resultados</h2><p>Prueba con otro nombre, disciplina o lugar.</p></div>
                <button class="button button-secondary" type="button" data-search-clear>Limpiar búsqueda</button>
            </div>
        </div>

        <!-- 3. MODAL DINÁMICO DE INFORMACIÓN DE EVENTO -->
        <div id="event-modal-backdrop" class="modal-backdrop" hidden aria-hidden="true">
            <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="modal-event-title" tabindex="-1">
                <button type="button" class="modal-close" id="modal-close-btn" aria-label="Cerrar ventana">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
                <div class="modal-cover">
                    <img id="modal-img" src="/images/evento-fallback.jpg" alt="" />
                    <span class="modal-date-badge" id="modal-date-badge">14 NOV</span>
                </div>
                <div class="modal-content-body">
                    <div class="modal-header-info">
                        <span class="eyebrow" id="modal-eyebrow">SÁBADO · 8:58 P. M.</span>
                        <h2 id="modal-event-title">Título del Evento</h2>
                        <div class="modal-location">
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"/><circle cx="12" cy="10" r="3"/></svg>
                            <span id="modal-location">Ubicación</span>
                        </div>
                    </div>

                    <p class="modal-description" id="modal-description">Descripción detallada del evento.</p>

                    <!-- Aforo y Concurrencia en tiempo real -->
                    <div class="modal-aforo-card">
                        <div class="modal-aforo-header">
                            <div>
                                <small>CONTROL DE AFORO EN TIEMPO REAL</small>
                                <strong>Disponibilidad de localidades</strong>
                            </div>
                            <span class="modal-aforo-stock" id="modal-stock-label">120 disponibles</span>
                        </div>
                        <div class="modal-aforo-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" id="modal-progress-bar">
                            <div class="modal-progress-fill" id="modal-progress-fill" style="width: 80%;"></div>
                        </div>
                    </div>

                    <!-- Tipos de entrada y precios -->
                    <div class="modal-tickets-block">
                        <h3>Tipos de Entrada Disponibles</h3>
                        <div class="modal-tickets-grid" id="modal-tickets-list">
                            <!-- Se renderizan los tipos de entrada -->
                        </div>
                    </div>

                    <!-- Pase digital y código de barras -->
                    <div class="modal-barcode-box" style="margin-bottom: 20px; padding: 12px 18px; background: #faf9f6; border: 1px dashed var(--line); border-radius: 14px; display: flex; align-items: center; justify-content: space-between; gap: 16px;">
                        <div>
                            <small style="display:block; font:800 8.5px var(--mono); color:var(--muted); letter-spacing:.08em;">CONTROL DE ACCESO DIGITAL</small>
                            <span id="modal-barcode-code" style="font:700 11px var(--mono); color:var(--ink); letter-spacing:.08em;">* EVT-000-ACCESO *</span>
                        </div>
                        <div style="flex: 0 0 140px;">
                            <svg class="pass-barcode" viewBox="0 0 160 32" preserveAspectRatio="none" style="width:100%; height:26px;" aria-hidden="true">
                                <rect x="0" y="0" width="2.5" height="32" fill="#0f0f0e"/>
                                <rect x="4.5" y="0" width="1.2" height="32" fill="#0f0f0e"/>
                                <rect x="7.5" y="0" width="3.2" height="32" fill="#0f0f0e"/>
                                <rect x="13" y="0" width="1.5" height="32" fill="#0f0f0e"/>
                                <rect x="16" y="0" width="4" height="32" fill="#0f0f0e"/>
                                <rect x="22" y="0" width="2" height="32" fill="#0f0f0e"/>
                                <rect x="26" y="0" width="1.2" height="32" fill="#0f0f0e"/>
                                <rect x="29" y="0" width="3" height="32" fill="#0f0f0e"/>
                                <rect x="34" y="0" width="2" height="32" fill="#0f0f0e"/>
                                <rect x="38" y="0" width="4.2" height="32" fill="#0f0f0e"/>
                                <rect x="44.5" y="0" width="1.2" height="32" fill="#0f0f0e"/>
                                <rect x="48" y="0" width="2.5" height="32" fill="#0f0f0e"/>
                                <rect x="52.5" y="0" width="3" height="32" fill="#0f0f0e"/>
                                <rect x="57.5" y="0" width="1.2" height="32" fill="#0f0f0e"/>
                                <rect x="61" y="0" width="2.2" height="32" fill="#0f0f0e"/>
                                <rect x="65" y="0" width="4" height="32" fill="#0f0f0e"/>
                                <rect x="71" y="0" width="1.5" height="32" fill="#0f0f0e"/>
                                <rect x="74.5" y="0" width="1.2" height="32" fill="#0f0f0e"/>
                                <rect x="78" y="0" width="3.2" height="32" fill="#0f0f0e"/>
                                <rect x="83.5" y="0" width="1.2" height="32" fill="#0f0f0e"/>
                                <rect x="87" y="0" width="2.5" height="32" fill="#0f0f0e"/>
                                <rect x="91.5" y="0" width="3.5" height="32" fill="#0f0f0e"/>
                                <rect x="97" y="0" width="1.5" height="32" fill="#0f0f0e"/>
                                <rect x="100.5" y="0" width="2.2" height="32" fill="#0f0f0e"/>
                                <rect x="105" y="0" width="4" height="32" fill="#0f0f0e"/>
                                <rect x="111" y="0" width="1.2" height="32" fill="#0f0f0e"/>
                                <rect x="114" y="0" width="3" height="32" fill="#0f0f0e"/>
                                <rect x="119" y="0" width="2" height="32" fill="#0f0f0e"/>
